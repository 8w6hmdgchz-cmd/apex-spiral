system:
  name: "NanoGPT-Claw"
  version: "1.0.0"
  mode: "daemon"
  max_concurrent_tasks: 5

cli:
  prompt: "nanogpt> "
  history_size: 100
  echo: true
  color_output: true

llm:
  core_model:
    id: "core-1"
    name: "Core Main LLM"
    role: "core"
    provider: "openai"
    api_key: "${OPENAI_API_KEY}"
    base_url: "https://api.openai.com/v1"
    model_name: "gpt-4"
    max_tokens: 4096
    temperature: 0.7
    top_p: 0.9
  auxiliary_models:
    - id: "aux-code-1"
      name: "Code Auditor"
      role: "code_audit"
      provider: "openai"
      api_key: "${OPENAI_API_KEY}"
      base_url: "https://api.openai.com/v1"
      model_name: "gpt-3.5-turbo"
      max_tokens: 2048
      temperature: 0.3
      top_p: 0.85
    - id: "aux-logic-1"
      name: "Logic Reviewer"
      role: "logic_review"
      provider: "openai"
      api_key: "${OPENAI_API_KEY}"
      base_url: "https://api.openai.com/v1"
      model_name: "gpt-3.5-turbo"
      max_tokens: 2048
      temperature: 0.2
      top_p: 0.8
    - id: "aux-vuln-1"
      name: "Vulnerability Detector"
      role: "vulnerability_detect"
      provider: "openai"
      api_key: "${OPENAI_API_KEY}"
      base_url: "https://api.openai.com/v1"
      model_name: "gpt-3.5-turbo"
      max_tokens: 2048
      temperature: 0.1
      top_p: 0.75
  request_timeout_secs: 120
  max_retries: 3
  retry_delay_ms: 1000

memory:
  short_term_ttl_hours: 24
  long_term_enabled: true
  similarity_threshold: 0.75
  max_short_term_items: 1000
  cleanup_interval_hours: 6

lark:
  enabled: false
  app_id: "${LARK_APP_ID}"
  app_secret: "${LARK_APP_SECRET}"
  bot_name: "NanoGPT-Claw Bot"
  webhook_url: "${LARK_WEBHOOK_URL}"
  verify_token: "${LARK_VERIFY_TOKEN}"
  encrypt_key: "${LARK_ENCRYPT_KEY}"
  event_callback_url: "/webhook/lark"
  auto_reply: true

github:
  enabled: false
  webhook_secret: "${GITHUB_WEBHOOK_SECRET}"
  repository: "owner/repo"
  auto_scan_enabled: true
  scan_interval_hours: 24
  auto_commit_enabled: false
  branches:
    - "main"
    - "master"

daemon:
  pid_file: "nanogpt-claw.pid"
  restart_delay_secs: 5
  max_restart_attempts: 10
  health_check_interval_secs: 60
  graceful_shutdown_timeout_secs: 30

logging:
  level: "info"
  file_enabled: true
  console_enabled: true
  max_file_size_mb: 100
  max_files: 10
  format: "json"
